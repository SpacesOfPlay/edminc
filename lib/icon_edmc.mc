// icon_edmc.mc - the edminc app logo: the minc-web favicon (favicon_ed.svg),
// a brand-blue rounded square with the staggered "ed"/"mc" lettering. It is
// rendered from the SVG at each size the editor needs and embedded as PNGs,
// so nothing is scaled up; icon_edmc_rgba decodes and caches the nearest
// size on demand. The .mc file-type icon in the tree is a separate mark
// (lib/icon_mc.mc).

import png;

const i32 ICON_EDMC_NSIZES = 7;
private i32[7] icon_edmc_sizes = { 16, 24, 32, 48, 64, 128, 256 };
private i32[7] icon_edmc_off = { 0, 416, 1032, 1887, 3198, 4939, 8565 };
private i32[7] icon_edmc_len = { 416, 616, 855, 1311, 1741, 3626, 7510 };
private u8*[7] icon_edmc_cache;   // decoded straight RGBA per size, lazily

// the i-th embedded PNG as stored, and its side in pixels: the build
// copies them into the Windows executable's icon resource
str icon_edmc_png_at(i32 i, i32* out_size) {
    if i < 0 || i >= ICON_EDMC_NSIZES { return ""; }
    *out_size = icon_edmc_sizes[i];
    return str_from(&icon_edmc_png[icon_edmc_off[i]], icon_edmc_len[i]);
}

// nearest embedded size >= target (else the largest); decode its PNG once,
// cache the straight-RGBA pixels, and return them. *out_size is the square
// side in pixels. null only if the decode fails.
u8* icon_edmc_rgba(i32 target, i32* out_size) {
    i32 pick = ICON_EDMC_NSIZES - 1;
    for i32 i = 0; i < ICON_EDMC_NSIZES; i++ {
        if icon_edmc_sizes[i] >= target { pick = i; break; }
    }
    *out_size = icon_edmc_sizes[pick];
    if icon_edmc_cache[pick] == null {
        PngImage img = png_decode(&icon_edmc_png[icon_edmc_off[pick]], cast(i64, icon_edmc_len[pick]));
        icon_edmc_cache[pick] = img.pixels;
    }
    return icon_edmc_cache[pick];
}

