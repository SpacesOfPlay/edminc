// theme.mc - the workbench design system as data: color tokens
// and DPI-derived metrics for the chrome. Values mirror the
// reference (doc/TECH_DOC.md "UI system"); widgets use tokens and the
// metric helpers, never raw colors or pixel constants. u32 color
// layout is R | G<<8 | B<<16 | A<<24.

// --- colors ---------------------------------------------------------
// Every color the editor draws with, one variable per slot. The values
// here are Dark+; theme_apply replaces them with a theme's table and
// the user's overrides (src/settings.mc). A slot's name is the reference
// editor's color id where one exists, so an override reads as it does
// there; the token slots use the short names of its
// editor.tokenColorCustomizations. The built-in themes' values come from
// theme files in the reference's format, its own and others (MIT, see
// THIRD_PARTY.md); a color a theme leaves out takes the reference's
// default for a dark or a light theme.

u32 C_BG = 0xFF1E1E1E;               // #1E1E1E the editor and the window clear
u32 C_FG = 0xFFD4D4D4;               // #D4D4D4 text with no token class
u32 C_LINENO = 0xFF858585;           // #858585 line numbers
u32 C_LINENO_CUR = 0xFFC6C6C6;       // #C6C6C6 the caret line's number
u32 C_CURLINE = 0xFF2E2D2A;          // #2A2D2E the caret line's band
u32 C_CARET = 0xFFE8E8E8;            // #E8E8E8 the caret; the fuzzer counts caret quads by it
u32 C_SEL = 0xFF784F26;              // #264F78 the selection
u32 C_FINDMARK = 0x55005CEA;         // #EA5C0055 find matches in the text
u32 C_LINK = 0xFFCE944E;             // #4E94CE the cmd+hover definition link
u32 C_SCROLL = 0xA0707070;           // #707070A0 scrollbar thumbs
u32 C_STATUS = 0xFFCC7A00;           // #007ACC the status bar
u32 C_STATUS_FG = 0xFFFFFFFF;        // #FFFFFF the status bar's text
u32 T_SIDEBAR_BG = 0xFF262525;       // #252526 the tree and the search panel
u32 T_HEADER_BG = 0xFF262525;        // #252526 pane banners
u32 T_HEADER_BORDER = 0xFF454545;    // #454545 the line under a pane banner
u32 T_DIVIDER = 0xFF454545;          // #454545 lines between panes
u32 T_WIDGET_BG = 0xFF262525;        // #252526 overlays, the find widget, notices
u32 T_WIDGET_BORDER = 0xFF454545;    // #454545 their border
u32 T_INPUT_BG = 0xFF3C3C3C;         // #3C3C3C input fields
u32 T_FOCUS = 0xFFD47F00;            // #007FD4 focus rings
u32 T_FG = 0xFFCCCCCC;               // #CCCCCC chrome text
u32 T_DIM = 0xFF7F7F7F;              // #7F7F7F secondary chrome text
u32 T_LIST_SEL = 0xFF714709;         // #094771 the selected row
u32 T_LIST_SEL_INACTIVE = 0xFF3D3737; // #37373D a selected row without the focus
u32 T_MATCH = 0xFFFB9700;            // #0097FB matched letters in a list
u32 T_MATCH_BG = 0xFF143261;         // #613214 a search match's box
u32 T_TITLEBAR = 0xFF3C3C3C;         // #3C3C3C the window caption
u32 T_TITLEBAR_FG = 0xFFCCCCCC;      // #CCCCCC caption text and buttons
u32 T_DIAG_ERROR = 0xFF4C4CF1;       // #F14C4C
u32 T_DIAG_WARN = 0xFF00A7CC;        // #CCA700
u32 T_DIAG_INFO = 0xFFFF9437;        // #3794FF
u32 T_DIAG_HINT = 0xFFB0B0B0;        // #B0B0B0
u32 T_GIT_ADD = 0xFF0C7C58;          // #587C0C
u32 T_GIT_MOD = 0xFF9D7D0C;          // #0C7D9D
u32 T_GIT_DEL = 0xFF1B1594;          // #94151B
u32 T_DIFF_ADD = 0xFF203A2D;         // #2D3A20
u32 T_DIFF_DEL = 0xFF22203A;         // #3A2022
u32 T_DIFF_FILL = 0xFF1A1A1A;        // #1A1A1A a diff side with no line opposite
u32 T_DIFF_HATCH = 0xFF3A3A3A;       // #3A3A3A that fill's rule lines
u32 T_DEC_MOD = 0xFF8DC0E2;          // #E2C08D
u32 T_DEC_ADD = 0xFF8BB881;          // #81B88B
u32 T_DEC_UNTRACKED = 0xFF91C973;    // #73C991
u32 T_DEC_DEL = 0xFF394EC7;          // #C74E39
u32 T_DEC_CONFLICT = 0xFF6B67E4;     // #E4676B
u32 T_ANSI0 = 0xFF000000;            // #000000
u32 T_ANSI1 = 0xFF3131CD;            // #CD3131
u32 T_ANSI2 = 0xFF79BC0D;            // #0DBC79
u32 T_ANSI3 = 0xFF10E5E5;            // #E5E510
u32 T_ANSI4 = 0xFFC87224;            // #2472C8
u32 T_ANSI5 = 0xFFBC3FBC;            // #BC3FBC
u32 T_ANSI6 = 0xFFCDA811;            // #11A8CD
u32 T_ANSI7 = 0xFFE5E5E5;            // #E5E5E5
u32 T_ANSI8 = 0xFF666666;            // #666666
u32 T_ANSI9 = 0xFF4C4CF1;            // #F14C4C
u32 T_ANSI10 = 0xFF8BD123;           // #23D18B
u32 T_ANSI11 = 0xFF43F5F5;           // #F5F543
u32 T_ANSI12 = 0xFFEA8E3B;           // #3B8EEA
u32 T_ANSI13 = 0xFFD670D6;           // #D670D6
u32 T_ANSI14 = 0xFFDBB829;           // #29B8DB
u32 T_ANSI15 = 0xFFE5E5E5;           // #E5E5E5
u32 T_TERM_FG = 0xFF14FE28;          // #28FE14 the terminal's built-in scheme
u32 T_TERM_BG = 0xFF000000;          // #000000
u32 T_TERM_BOLD = 0xFF00FF00;        // #00FF00 bold text there
u32 T_TERM_CURSOR = 0xFF27FE38;      // #38FE27
u32 T_TERM_SEL = 0xFF970006;         // #060097
u32 C_CTRL = 0xFFC086C5;             // #C586C0 control keywords
u32 C_DECL = 0xFFD69C56;             // #569CD6 declarations, types, constants
u32 C_TYPE = 0xFFB0C94E;             // #4EC9B0 user types
u32 C_VAR = 0xFFFEDC9C;              // #9CDCFE variables
u32 C_FN = 0xFFAADCDC;               // #DCDCAA functions
u32 C_STRLIT = 0xFF7891CE;           // #CE9178 strings
u32 C_ESC = 0xFF7DBAD7;              // #D7BA7D string escapes
u32 C_NUM = 0xFFA8CEB5;              // #B5CEA8 numbers
u32 C_COM = 0xFF55996A;              // #6A9955 comments
u32 C_PRE = 0xFFC086C5;              // #C586C0 directives
u32 C_MDLIST = 0xFFE69667;           // #6796E6 markdown list markers

