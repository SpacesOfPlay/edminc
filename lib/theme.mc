const u32 T_BRAND = 0xFF1A5AFF;          // #FF5A1A the project mark's orange

// the embedded .mc icon's pseudo-codepoint (see lib/icon_mc.mc and
// the glyph cache); outside Unicode so text never produces it
const u32 ICON_MC = 0xF0000;
// the app logo ("ed" over "mc", lib/icon_edmc.mc): the caption's brand
// mark and the window/OS icon, distinct from the .mc file-type icon
const u32 ICON_EDMC = 0xF0001;

// File-type icon + color, mirroring the reference icon theme's
// mapping (seti glyphs at U+E0xx from assets/seti.ttf); .mc gets
// the project mark in its brand orange.
u32 theme_file_icon(str name, u32* col) {
    if str_ends_with(name, ".mc") {
        *col = T_BRAND;
        return ICON_MC;
    }
    if str_ends_with(name, ".md") {
        if str_equal(name, "LICENSE.md") {
            *col = 0xFF41CBCB;   // #cbcb41
            return 0xE05A;
        }
        *col = 0xFFBA9A51;   // #519aba
        return 0xE060;
    }
    if str_ends_with(name, ".json") {
        *col = 0xFF41CBCB;
        return 0xE055;
    }
    if str_ends_with(name, ".js") {
        *col = 0xFF41CBCB;
        return 0xE051;
    }
    if str_ends_with(name, ".ts") {
        *col = 0xFFBA9A51;
        return 0xE099;
    }
    if str_ends_with(name, ".py") {
        *col = 0xFFBA9A51;
        return 0xE07B;
    }
    if str_ends_with(name, ".ps1") {
        *col = 0xFFBA9A51;
        return 0xE074;
    }
    if str_ends_with(name, ".sh") {
        *col = 0xFF49C18D;   // #8dc149
        return 0xE089;
    }
    if str_ends_with(name, ".yml") || str_ends_with(name, ".yaml") {
        *col = 0xFFC474A0;   // #a074c4
        return 0xE0A7;
    }
    if str_ends_with(name, ".html") {
        *col = 0xFF3379E3;   // #e37933
        return 0xE048;
    }
    if str_ends_with(name, ".xml") {
        *col = 0xFF3379E3;
        return 0xE0A5;
    }
    if str_ends_with(name, ".css") {
        *col = 0xFFBA9A51;
        return 0xE01D;
    }
    if str_ends_with(name, ".c") {
        *col = 0xFFBA9A51;
        return 0xE00C;
    }
    if str_ends_with(name, ".h") {
        *col = 0xFFC474A0;
        return 0xE00C;
    }
    if str_ends_with(name, ".cpp") {
        *col = 0xFFBA9A51;
        return 0xE01A;
    }
    if str_ends_with(name, ".toml") {
        *col = 0xFF86806D;   // #6d8086
        return 0xE019;
    }
    if str_ends_with(name, ".ttf") || str_ends_with(name, ".woff") {
        *col = 0xFF443ECC;   // #cc3e44
        return 0xE033;
    }
    if str_ends_with(name, ".svg") {
        *col = 0xFFC474A0;
        return 0xE091;
    }
    if str_ends_with(name, ".png") || str_ends_with(name, ".jpg")
        || str_ends_with(name, ".jpeg") || str_ends_with(name, ".gif") {
        *col = 0xFFC474A0;
        return 0xE04C;
    }
    if str_equal(name, ".gitignore") || str_equal(name, ".gitattributes") {
        *col = 0xFF5B5341;   // #41535b
        return 0xE034;
    }
    if str_equal(name, "LICENSE") {
        *col = 0xFF41CBCB;
        return 0xE05A;
    }
    *col = 0xFFD6D7D4;       // #d4d7d6 generic file
    return 0xE023;
}

// The terminal's sixteen ANSI colors: the eight normal ones then the
// eight bright. The 256-color cube and the grays above them are
// computed from the index, and truecolor is taken as given, so these
// sixteen are the whole palette a theme owns.
u32 theme_ansi(i32 i) {
    if i == 0 { return T_ANSI0; }
    if i == 1 { return T_ANSI1; }
    if i == 2 { return T_ANSI2; }
    if i == 3 { return T_ANSI3; }
    if i == 4 { return T_ANSI4; }
    if i == 5 { return T_ANSI5; }
    if i == 6 { return T_ANSI6; }
    if i == 7 { return T_ANSI7; }
    if i == 8 { return T_ANSI8; }
    if i == 9 { return T_ANSI9; }
    if i == 10 { return T_ANSI10; }
    if i == 11 { return T_ANSI11; }
    if i == 12 { return T_ANSI12; }
    if i == 13 { return T_ANSI13; }
    if i == 14 { return T_ANSI14; }
    return T_ANSI15;
}

// LSP severity is 1..4; anything else reads as an error, which is the
// safe way round
u32 theme_diag_color(i32 severity) {
    if severity == 2 { return T_DIAG_WARN; }
    if severity == 3 { return T_DIAG_INFO; }
    if severity == 4 { return T_DIAG_HINT; }
    return T_DIAG_ERROR;
}

// Metrics derive from the line height so they scale with DPI. The
// fractions come from capture measurements of the reference find
// widget; see doc/TECH_DOC.md "UI system".

// corner radius of inputs and panels
i32 ui_rad() {
    return font_line_h / 10;
}

// horizontal text inset inside an input box
i32 ui_inset() {
    return font_line_h / 3;
}

// vertical text padding inside an input box
i32 ui_pad() {
    return font_line_h / 6;
}

// full outer height of an input box, 2px focus ring included
i32 ui_input_h() {
    return font_line_h + 2 * ui_pad() + 4;
}

// --- themes -------------------------------------------------------------

i32 theme_count() {
    return THEME_COUNT;
}

str theme_name(i32 t) {
    if t < 0 || t >= THEME_COUNT { return ""; }
    return theme_names[t];
}

// the theme in use
i32 theme_current() {
    return theme_cur;
}

private u8 theme_lower(u8 c) {
    if c >= 'A' && c <= 'Z' { return cast(u8, c + 32); }
    return c;
}

private bool theme_same(str a, str b) {
    if a.len != b.len { return false; }
    for i32 i = 0; i < a.len; i++ {
        if theme_lower(a.data[i]) != theme_lower(b.data[i]) { return false; }
    }
    return true;
}

// a theme by name, ignoring case; -1 when there is none
i32 theme_find(str name) {
    for i32 t = 0; t < THEME_COUNT; t++ {
        if theme_same(theme_names[t], name) { return t; }
    }
    return -1;
}

// Start the palette from theme t's table. Overrides go on top with
// theme_override, and theme_commit hands the result to the drawing code.
void theme_load(i32 t) {
    if t < 0 || t >= THEME_COUNT { t = 0; }
    theme_cur = t;
    u32* tab = theme_table(t);
    for i32 i = 0; i < THEME_SLOTS; i++ { theme_pal[i] = tab[i]; }
}

// one slot by name; false when no slot has that name
bool theme_override(str id, u32 color) {
    for i32 i = 0; i < THEME_SLOTS; i++ {
        if theme_same(theme_ids[i], id) {
            theme_pal[i] = color;
            return true;
        }
    }
    return false;
}

void theme_commit() {
    theme_store();
}

private i32 theme_hex(u8 c) {
    if c >= '0' && c <= '9' { return cast(i32, c - '0'); }
    c = theme_lower(c);
    if c >= 'a' && c <= 'f' { return cast(i32, c - 'a') + 10; }
    return -1;
}

// "#RGB", "#RGBA", "#RRGGBB" or "#RRGGBBAA" into the u32 layout above
bool theme_parse_color(str s, u32* out) {
    if s.len < 1 || s.data[0] != '#' { return false; }
    i32 n = s.len - 1;
    if n != 3 && n != 4 && n != 6 && n != 8 { return false; }
    i32[8] d;
    for i32 i = 0; i < n; i++ {
        d[i] = theme_hex(s.data[1 + i]);
        if d[i] < 0 { return false; }
    }
    u32 r = 0;
    u32 g = 0;
    u32 b = 0;
    u32 a = 255;
    if n <= 4 {
        r = cast(u32, d[0] * 17);
        g = cast(u32, d[1] * 17);
        b = cast(u32, d[2] * 17);
        if n == 4 { a = cast(u32, d[3] * 17); }
    } else {
        r = cast(u32, d[0] * 16 + d[1]);
        g = cast(u32, d[2] * 16 + d[3]);
        b = cast(u32, d[4] * 16 + d[5]);
        if n == 8 { a = cast(u32, d[6] * 16 + d[7]); }
    }
    *out = r | (g << 8) | (b << 16) | (a << 24);
    return true;
}

// a color with its alpha replaced, for the translucent hover shades
// drawn in a slot's color
u32 theme_alpha(u32 c, u32 a) {
    return (c & 0x00FFFFFF) | (a << 24);
}
