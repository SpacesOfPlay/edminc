// the palette in use: a theme's table with the overrides on top
private u32[THEME_SLOTS] theme_pal;
private i32 theme_cur = 0;

private u32* theme_table(i32 t) {
    if t == 1 { return &theme_table_1[0]; }
    if t == 2 { return &theme_table_2[0]; }
    if t == 3 { return &theme_table_3[0]; }
    if t == 4 { return &theme_table_4[0]; }
    if t == 5 { return &theme_table_5[0]; }
    if t == 6 { return &theme_table_6[0]; }
    if t == 7 { return &theme_table_7[0]; }
    if t == 8 { return &theme_table_8[0]; }
    if t == 9 { return &theme_table_9[0]; }
    if t == 10 { return &theme_table_10[0]; }
    if t == 11 { return &theme_table_11[0]; }
    if t == 12 { return &theme_table_12[0]; }
    if t == 13 { return &theme_table_13[0]; }
    if t == 14 { return &theme_table_14[0]; }
    if t == 15 { return &theme_table_15[0]; }
    if t == 16 { return &theme_table_16[0]; }
    if t == 17 { return &theme_table_17[0]; }
    if t == 18 { return &theme_table_18[0]; }
    if t == 19 { return &theme_table_19[0]; }
    if t == 20 { return &theme_table_20[0]; }
    if t == 21 { return &theme_table_21[0]; }
    if t == 22 { return &theme_table_22[0]; }
    if t == 23 { return &theme_table_23[0]; }
    return &theme_table_0[0];
}

